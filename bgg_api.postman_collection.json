        "value": "41b9b686-8528-4ab6-ba94-76a58e657b4c",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Search Games",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://boardgamegeek.com/xmlapi2/search?query=catan&type=boardgame",
          "protocol": "https",
          "host": ["boardgamegeek", "com"],
          "path": ["xmlapi2", "search"],
          "query": [
            { "key": "query", "value": "catan" },
            { "key": "type", "value": "boardgame" },
            { "key": "exact", "value": "1", "disabled": true }
