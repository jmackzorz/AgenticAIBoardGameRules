        },
        "description": "Search for board games by name. Enable 'exact' param for exact name match only."
      }
    },
    {
      "name": "Get Game Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://boardgamegeek.com/xmlapi2/thing?id=13,822&stats=1",
          "protocol": "https",
          "host": ["boardgamegeek", "com"],
          "path": ["xmlapi2", "thing"],
          "query": [
            { "key": "id", "value": "13,822", "description": "Comma-separated BGG game IDs. 13=Catan, 822=Carcassonne" },
            { "key": "stats", "value": "1", "description": "Include ratings and rankings" }
          ]
        },
        "description": "Fetch full details for one or more games by BGG ID. Up to 20 IDs comma-separated."
      }
    },
    {
      "name": "Hot Games",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
